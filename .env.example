# Required: paste these values in Vercel > Project > Settings > Environment Variables.
# For local use, copy this file to .env.local. Never upload .env.local to GitHub.
DATABASE_URL=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: deployed origin; needed only when enabling email registration.
APP_URL=
# Default false. Owner login works without SMTP or email verification.
REGISTRATION_ENABLED=false
# Only required if REGISTRATION_ENABLED=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
